{
  "name": "propaid-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply propaid --local",
    "predb:remote": "node scripts/backup-d1.mjs",
    "db:remote": "wrangler d1 migrations apply propaid --remote",
    "backup:remote": "node scripts/backup-d1.mjs",
    "restore:drill": "node scripts/restore-drill.mjs"
  },
  "dependencies": {
    "hono": "^4.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.118.0"
  }
}
