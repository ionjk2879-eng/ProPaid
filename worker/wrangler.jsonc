{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propaid-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://propaid-api.ionjk2879.workers.dev,http://localhost:5173,http://localhost:8787",
    "RESEND_RECEIVING_DOMAIN": "zenuuxdoeu.resend.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propaid",
      "database_id": "f1a8bfb8-b597-4cb2-975f-65a0d52133db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "propaid-evidence"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "propaid-backups"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "propaid_metrics"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ANALYSIS_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "MAIL_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ]
  // Cloudflare 크론 트리거는 쓰지 않는다 — Workers Free 플랜은 계정 전체(이 계정의 다른 프로젝트 포함)에서
  // 크론 트리거를 5개까지만 허용하는데 다른 프로젝트가 이미 다 쓰고 있다. 대신 .github/workflows/scheduled-maintenance.yml이
  // GitHub Actions 스케줄로 /api/admin/run-maintenance, /api/admin/run-failure-alert-check를 호출한다.
}
